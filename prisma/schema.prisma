// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "sqlite", "mysql", etc.
  url      = env("DATABASE_URL")
}

// --------------------
// Player Table
// --------------------
model Player {
  id           Int      @id @default(autoincrement())
  number       String
  name         String
  nickname     String?
  dateOfBirth  String
  nationality  String
  pos          String
  position     String
  height       String?
  weight       String?
  bio          String?
  imageUrl     String?
  social       String?
}

// --------------------
// News Table
// --------------------
model News {
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  // excerpt   String
  imageUrl  String?
  content   String
}

// --------------------
// Ticket Table
// --------------------
model Event {
  id           String   @id @default(cuid())
  title        String
  date         String
  competition  String
  venue        String
  thumbnail    String
  soldOut      Boolean  @default(false)
  description  String?
  tiers        Tier[] 
}

model Tier {
  id        String   @id @default(cuid())
  name      String
  price     Float
  available Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
}


model Itemshop {
  id String   @id @default(cuid())
   
    name String
    price Int
    imageUrl String
    isNew Boolean?
    inStock Int?
    description String?
}

model Purchase {
  id Int @id @default(autoincrement())
  productname String
  quantity Int
  price Float
  subtotal Float
  amountPaid Float?
  total Float
  purchaseDate String
}